it. \n        // A simple check is to see if the button has a specific data attribute we might set, \n        // or just rely on the fact that standard named functions can be overridden.\n        // For now, we will assume this script runs IF the header script didn't run or isn't present.\n    }\n});\n</script>\n\n</body>\n</html>\n<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n    // Chart Config\n    const commonOptions = {\n        responsive: true,\n        maintainAspectRatio: false,\n        plugins: { legend: { display: false } },\n        cutout: '70%'\n    };\n\n    // 1. Capital Chart\n        const ctxCap = document.getElementById('capitalChart');\n    if(ctxCap) {\n        new Chart(ctxCap, {\n            type: 'doughnut',\n            data: {\n                labels: ['Paid-up', 'Uncalled'],\n                datasets: [{\n                    data: [0, 100000],\n                    backgroundColor: ['#10B981', '#E5E7EB'],\n                    borderWidth: 0\n                }]\n            },\n            options: commonOptions\n        });\n    }\n    \n    // 2. Directors Chart\n        const ctxDir = document.getElementById('directorsChart');\n    if(ctxDir) {\n        new Chart(ctxDir, {\n            type: 'doughnut',\n            data: {\n                labels: ['Active', 'Resigned'],\n                datasets: [{\n                    data: [1, 1],\n                    backgroundColor: ['#3B82F6', '#F87171'], // Blue-500, Red-400\n                    borderWidth: 0\n                }]\n            },\n            options: commonOptions\n        });\n    }\n    \n    // 3. Charges Chart\n    });\n</script>",
