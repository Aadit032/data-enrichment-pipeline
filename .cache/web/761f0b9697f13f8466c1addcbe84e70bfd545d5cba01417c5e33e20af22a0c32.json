tive.</div>\n                        \n        <div class=\"buttons\">\n            <input type=\"submit\" class=\"btn btn-primary\" value=\"Login\" /> or \n            <a href=\"/register\">REGISTER</a>        </div>\n\n        </form>    </div>\n</div>    </div>\n</div>\n\n        </div><!-- content -->\n    </div>\n</div>\n<div style=\"margin-bottom: 1px;\">\n\t<div class=\"adsBanner\">\n<!-- ADVERTISING START-->\n<div class=\"str3 mWrap imageString\">\n\t<div class=\"mMove\">\n<!--Start Your Content-->\n<!--footer-->\n<!--End Your Content-->\n    </div>\n</div>\t\t\n</div>\n<!-- ADVERTISING END-->\n</div>\t\n                </body>\n                </html>",
