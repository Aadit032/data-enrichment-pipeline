tent = new Date().getFullYear();\n    }\n\n    // 2. FAQ Accordion Logic (Preserved for internal pages)\n    const faqHeaders = document.querySelectorAll('.faq-item h4');\n    faqHeaders.forEach(faqHeader => {\n        faqHeader.addEventListener('click', () => {\n            const faqItem = faqHeader.parentElement;\n            const faqIcon = faqHeader.querySelector('.faq-icon');\n            const isOpen = faqItem.classList.contains('open');\n\n            // Close others (optional, remove if you want multiple open)\n            // document.querySelectorAll('.faq-item').forEach(item => {\n            //     if(item !== faqItem) item.classList.remove('open');\n            // });\n\n            faqItem.classList.toggle('open');\n            faqHeader.setAttribute('aria-expanded', !isOpen);\n\n            // Icon rotation/switch logic\n            if (faqIcon) {\n                if (!isOpen) { // Opening\n                    faqIcon.classList.add('rotate-180'); \n                    if(faqIcon.textContent.trim() === '+') faqIcon.textContent = '−';\n                } else { // Closing\n                    faqIcon.classList.remove('rotate-180');\n                    if(faqIcon.textContent.trim() === '−') faqIcon.textContent = '+';\n                }\n            }\n        });\n\n        // Accessibility\n        faqHeader.addEventListener('keypress', (e) => {\n            if (e.key === 'Enter' || e.key === ' ') {\n                e.preventDefault();\n                faqHeader.click();\n            }\n        });\n    });\n\n    // 3. Mobile Menu Logic (Redundant backup if header script fails, but safe)\n    const mobileMenuButton = document.getElementById('mobile-menu-button');\n    const mobileMenu = document.getElementById('mobile-menu');\n    const iconOpen = document.getElementById('icon-open');\n    const iconClose = document.getElementById('icon-close');\n\n    if (mobileMenuButton && mobileMenu) {\n        // Remove old event listeners by cloning (optional) or 