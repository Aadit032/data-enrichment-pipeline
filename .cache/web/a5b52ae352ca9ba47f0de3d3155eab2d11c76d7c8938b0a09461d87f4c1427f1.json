 catch (e) {}\n    if (!stored) { banner.style.display = ''; }\n    function hide() {\n        banner.classList.add('hiding');\n        setTimeout(function(){ banner.style.display = 'none'; banner.classList.remove('hiding'); }, 300);\n    }\n    window.acceptCookies = function() {\n        try { localStorage.setItem('ga_consent', 'granted'); } catch (e) {}\n        if (typeof gtag === 'function') {\n            gtag('consent', 'update', {\n                ad_storage: 'granted',\n                ad_user_data: 'granted',\n                ad_personalization: 'granted',\n                analytics_storage: 'granted'\n            });\n        }\n        hide();\n    };\n    window.declineCookies = function() {\n        try { localStorage.setItem('ga_consent', 'denied'); } catch (e) {}\n        hide();\n    };\n    window.openCookieBanner = function() {\n        banner.classList.remove('hiding');\n        banner.style.display = '';\n    };\n})();\n</script>\n</body>\n</html>",
