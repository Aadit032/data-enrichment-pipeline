r\n      margin-bottom: 25px;\r\n    }\r\n\r\n    .hero-buttons {\r\n      display: flex;\r\n      gap: 10px;\r\n    }\r\n\r\n    .btn-primary {\r\n      flex: 1;\r\n      background: #12B8A6;\r\n      color: white;\r\n      padding: 15px 14px;\r\n      border-radius: 12px;\r\n      text-align: center;\r\n      font-weight: 800;\r\n      font-size: 14px;\r\n      box-shadow: 0 10px 25px rgba(18,184,166,0.25);\r\n    }\r\n\r\n    .btn-secondary {\r\n      flex: 1;\r\n      border: 1px solid rgba(255,255,255,0.2);\r\n      color: white;\r\n      padding: 15px 14px;\r\n      border-radius: 12px;\r\n      text-align: center;\r\n      font-weight: 700;\r\n      font-size: 14px;\r\n      background: rgba(255,255,255,0.04);\r\n    }\r\n\r\n    /* =========================\r\n       TRUST BAR\r\n    ========================= */\r\n\r\n    .trust-bar {\r\n      background: white;\r\n      display: grid;\r\n      grid-template-columns: repeat(3, 1fr);\r\n      padding: 19px 10px;\r\n      box-shadow: 0 4px 20px rgba(16,24,40,0.06);\r\n    }\r\n\r\n    .trust-item {\r\n      text-align: center;\r\n      border-right: 1px solid #E7EBF0;\r\n    }\r\n\r\n    .trust-item:last-child {\r\n      border: none;\r\n    }\r\n\r\n    .trust-number {\r\n      color: #087F8C;\r\n      font-weight: 900;\r\n      font-size: 18px;\r\n    }\r\n\r\n    .trust-label {\r\n      font-size: 9px;\r\n      color: #667085;\r\n      margin-top: 4px;\r\n      text-transform: uppercase;\r\n      letter-spacing: 0.4px;\r\n    }\r\n\r\n    /* =========================\r\n       SECTION\r\n    ========================= */\r\n\r\n    .section {\r\n      padding: 42px 20px;\r\n    }\r\n\r\n    .section-tag {\r\n      color: #087F8C;\r\n      font-size: 11px;\r\n      font-weight: 900;\r\n      text-transform: uppercase;\r\n      letter-spacing: 1.5px;\r\n      margin-bottom: 8px;\r\n    }\r\n\r\n    .section-title {\r\n      font-size: 28px;\r\n      line-height: 1.15;\r\n      letter-spacing: -1px;\r\n      margin-bottom: 10px;\r\n      color: #101828;\r\n    }\r\n\r\n    .section-text {\r\n      color: #667085;\r\n      font-size: 14px;\r\n      line-height: 1.65;\r\n      margin-bottom: 25px;\r\n    }\r\n\r\n    /* =========================\r\n       SERVICES\r\n    ========================= */\r\n\r\n    .services {\r\n      display: grid;\r\n      gap: 12px;\r\n    }\r\n\r\n    .service-card {\r\n      background: white;\r\n      border: 1px solid #E7EBF0;\r\n      border-radius: 17px;\r\n      padding: 17px;\r\n      display: flex;\r\n      align-items: center;\r\n      gap: 14px;\r\n      box-shadow: 0 5px 18px rgba(16,24,40,0.045);\r\n      transition: 0.2s;\r\n    }\r\n\r\n    .service-icon {\r\n      min-width: 49px;\r\n      width: 49px;\r\n      height: 49px;\r\n      border-radius: 14px;\r\n      background: #E9F8F6;\r\n      color: #087F8C;\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n      font-size: 22px;\r\n    }\r\n\r\n    .service-content {\r\n      flex: 1;\r\n    }\r\n\r\n    .service-content h3 {\r\n      font-size: 15px;\r\n      margin-bottom: 4px;\r\n      color: #101828;\r\n    }\r\n\r\n    .service-content p {\r\n      color: #667085;\r\n      font-size: 11px;\r\n      line-height: 1.45;\r\n    }\r\n\r\n    .service-arrow {\r\n      color: #12B8A6;\r\n      font-size: 20px;\r\n      font-weight: bold;\r\n    }\r\n\r\n    /* =========================\r\n       WHY US\r\n    ========================= */\r\n\r\n    .why-section {\r\n      background: #07111F;\r\n      color: white;\r\n      padding: 42px 20px;\r\n    }\r\n\r\n    .why-section .section-tag {\r\n      color: #4FD7C8;\r\n    }\r\n\r\n    .why-section .section-title {\r\n      color: white;\r\n    }\r\n\r\n    .why-section .section-text {\r\n      color: #AEBAC7;\r\n    }\r\n\r\n    .benefit {\r\n      display: flex;\r\n      gap: 13px;\r\n      padding: 15px 0;\r\n      border-bottom: 1px solid rgba(255,255,255,0.09);\r\n    }\r\n\r\n    