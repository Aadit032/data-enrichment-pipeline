ze: 12px;\r\n      line-height: 1.6;\r\n      color: #D6F4F1;\r\n      margin-bottom: 20px;\r\n    }\r\n\r\n    .cta-button {\r\n      display: block;\r\n      background: white;\r\n      color: #087F8C;\r\n      padding: 15px;\r\n      border-radius: 12px;\r\n      font-size: 14px;\r\n      font-weight: 900;\r\n    }\r\n\r\n    /* =========================\r\n       CONTACT\r\n    ========================= */\r\n\r\n    .contact-box {\r\n      background: white;\r\n      border: 1px solid #E7EBF0;\r\n      border-radius: 18px;\r\n      overflow: hidden;\r\n    }\r\n\r\n    .contact-row {\r\n      padding: 17px;\r\n      display: flex;\r\n      align-items: center;\r\n      gap: 13px;\r\n      border-bottom: 1px solid #EEF1F4;\r\n    }\r\n\r\n    .contact-row:last-child {\r\n      border-bottom: none;\r\n    }\r\n\r\n    .contact-icon {\r\n      width: 40px;\r\n      height: 40px;\r\n      background: #E9F8F6;\r\n      color: #087F8C;\r\n      border-radius: 11px;\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n    }\r\n\r\n    .contact-row small {\r\n      display: block;\r\n      color: #98A2B3;\r\n      font-size: 10px;\r\n      margin-bottom: 3px;\r\n    }\r\n\r\n    .contact-row strong {\r\n      font-size: 13px;\r\n      word-break: break-word;\r\n    }\r\n\r\n    /* =========================\r\n       FOOTER\r\n    ========================= */\r\n\r\n    footer {\r\n      background: #050C16;\r\n      color: white;\r\n      padding: 30px 20px 25px;\r\n      text-align: center;\r\n    }\r\n\r\n    footer strong {\r\n      font-size: 17px;\r\n    }\r\n\r\n    footer p {\r\n      color: #8492A3;\r\n      font-size: 10px;\r\n      margin-top: 8px;\r\n      line-height: 1.6;\r\n    }\r\n\r\n    .copyright {\r\n      border-top: 1px solid rgba(255,255,255,0.08);\r\n      margin-top: 20px;\r\n      padding-top: 18px;\r\n      color: #657384;\r\n      font-size: 9px;\r\n    }\r\n\r\n    /* =========================\r\n      