# Exa web-search API key (https://dashboard.exa.ai/api-keys) - free $20 on signup
EXA_API_KEY=

# LLM API key - either OpenRouter (https://openrouter.ai/keys) or Groq (https://console.groq.com/keys)
OPENROUTER_API_KEY=

# --- Optional overrides -----------------------------------------------------
# LLM model used for entity resolution + extraction
#   Groq (free): openai/gpt-oss-20b   |   OpenRouter: openai/gpt-4o-mini
# OPENROUTER_MODEL=openai/gpt-oss-20b
# OpenAI-compatible endpoint
#   Groq: https://api.groq.com/openai/v1   |   OpenRouter: https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=https://api.groq.com/openai/v1

# Number of results Exa returns per query
# EXA_NUM_RESULTS=5
# Max candidate domains considered per company
# MAX_CANDIDATES=5
# Minimum confidence for a match to be accepted (0.0-1.0)
# ENTITY_MATCH_THRESHOLD=0.7

# HTTP request timeout (seconds)
# REQUEST_TIMEOUT=25
# LLM request timeout (seconds)
# LLM_TIMEOUT=90
# Retry attempts for transient API/network failures
# MAX_RETRIES=3
# Pause (seconds) between LLM API calls to avoid rate limiting
# LLM_CALL_DELAY=5

# Where local JSON caches live
# CACHE_DIR=.cache
# Max characters of page text kept as evidence
# MAX_PAGE_TEXT_CHARS=6000
# Max characters of page text shown to the LLM
# PROMPT_TEXT_CHARS=3500
# Min clean-text chars before a page is considered "sufficient"
# MIN_GOOD_TEXT_CHARS=300

# Enable Playwright rendering fallback for JS-heavy sites
# USE_PLAYWRIGHT=true
